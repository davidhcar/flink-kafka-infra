# ==============================================================================
# Flinkflow Local Environment Configuration (env.local)
# Single Source of Truth for local environment connection variables.
#
# Usage:
#   - Automatically loaded by mise via [env] table in mise.toml
#   - Automatically loaded by docker compose via env_file in docker-compose.yml
#
# Production (Kubernetes) Pattern:
#   - In Prod/K8s, these are injected into pods via Kubernetes ConfigMaps/Secrets
#     or referenced directly in YAML steps using secret:name/key
# ==============================================================================

# ------------------------------------------------------------------------------
# Apache Kafka
# ------------------------------------------------------------------------------
# Inside Docker container network (JobManager / TaskManager -> Kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# From Host machine (e.g. local CLI or standalone runners)
KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:9092

# Default Kafka Topics & Consumer Groups
KAFKA_SOURCE_TOPIC=source-topic
KAFKA_SINK_TOPIC=sink-topic
KAFKA_GROUP_ID=flinkflow-group

WEBTRAFFIC_TOPIC=webtraffic
WEBTRAFFIC_ALERTS_TOPIC=webtraffic-alerts
WEBTRAFFIC_GROUP_ID=webtraffic-report-group-v2

OMOP_EVENTS_TOPIC=omop-standard-events
OMOP_ALERTS_TOPIC=omop-clinical-alerts

# ------------------------------------------------------------------------------
# Confluent Schema Registry & Kafka Connect
# ------------------------------------------------------------------------------
SCHEMA_REGISTRY_URL=http://schema-registry:8081
SCHEMA_REGISTRY_URL_LOCAL=http://localhost:8084

KAFKA_CONNECT_URL=http://kafka-connect:8083
KAFKA_CONNECT_URL_LOCAL=http://localhost:8083

# ------------------------------------------------------------------------------
# Apache Flink Cluster
# ------------------------------------------------------------------------------
FLINK_JOBMANAGER_URL=http://ff-jobmanager:8081
FLINK_JOBMANAGER_URL_LOCAL=http://localhost:8081

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outbox_demo
POSTGRES_URL=jdbc:postgresql://postgres:5432/outbox_demo
POSTGRES_URL_LOCAL=jdbc:postgresql://localhost:5432/outbox_demo

# ------------------------------------------------------------------------------
# OMOP Vocabulary Service
# ------------------------------------------------------------------------------
VOCAB_SERVICE_URL=http://vocab-service:8082
VOCAB_SERVICE_URL_LOCAL=http://localhost:8082

# ------------------------------------------------------------------------------
# Langfuse LLM Observability Stack
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=langfuse_password
CLICKHOUSE_DB=langfuse

MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_LOCAL=http://localhost:9000
MINIO_CONSOLE_URL_LOCAL=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword

REDIS_HOST=redis
REDIS_PORT=6379

LANGFUSE_URL=http://langfuse:3000
LANGFUSE_URL_LOCAL=http://localhost:4000

