{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OmopCdssAiAlert",
  "description": "AI-Synthesized Clinical Decision Support (CDSS) Alert with Multi-Source OMOP Evidence and LLM Reasoning",
  "type": "object",
  "required": [
    "patient_id",
    "window_start",
    "window_end",
    "ai_triage_level",
    "clinical_assessment",
    "differential_diagnosis",
    "recommended_interventions",
    "llm_provider",
    "llm_model"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Unique Patient Identifier / Medical Record Number"
    },
    "window_start": {
      "type": "string",
      "description": "Flink Aggregation Window Start Timestamp"
    },
    "window_end": {
      "type": "string",
      "description": "Flink Aggregation Window End Timestamp"
    },
    "ai_triage_level": {
      "type": "string",
      "description": "AI-determined acuity (e.g. 🚨 CRITICAL, ⚠️ URGENT, 🟡 WARNING, 🟢 STABLE)"
    },
    "clinical_assessment": {
      "type": "string",
      "description": "Evidence-based diagnostic reasoning generated by the LLM"
    },
    "differential_diagnosis": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Top suspected medical conditions"
    },
    "recommended_interventions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Suggested immediate clinical interventions / medical orders"
    },
    "vitals_summary": {
      "type": "object",
      "properties": {
        "max_systolic_bp": { "type": "number" },
        "max_heart_rate": { "type": "number" }
      }
    },
    "labs_summary": {
      "type": "object",
      "properties": {
        "max_lactate": { "type": "number" },
        "max_potassium": { "type": "number" },
        "max_glucose": { "type": "number" }
      }
    },
    "meds_and_dx_summary": {
      "type": "object",
      "properties": {
        "sepsis_dx_count": { "type": "integer" },
        "vasopressor_dispenses": { "type": "integer" },
        "total_med_dispenses": { "type": "integer" }
      }
    },
    "llm_provider": {
      "type": "string",
      "description": "Active LLM Provider (e.g. gemini, openai, ollama)"
    },
    "llm_model": {
      "type": "string",
      "description": "Model ID used for inference (e.g. gemini-2.0-flash, gpt-4o, llama3)"
    }
  }
}
